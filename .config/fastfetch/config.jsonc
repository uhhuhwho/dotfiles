{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "showErrors": false,
    "separator": "    "
  },
  "modules": [
    { "type": "custom", "format": "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓" },
    "break",
    // os age
    { "type": "os", "key": "   ", "keyColor": "blue" },
    {
	    "key": "  󱑀 ",
    	"type": "disk",
	    "keyColor": "97",
	    "folders": "/",
	    "format": "OS Age ({days} days) since ({create-time:10})"
	},
    { "type": "kernel", "key": "   ", "keyColor": "white" },
    { "type": "InitSystem", "key": "  󱓞 ", "keyColor": "red" },
    { "type": "packages", "key": "  󰮯 ", "keyColor": "yellow" },
    { "type": "LM", "key": "  󰨇 ", "keyColor": "yellow" },
    { "type": "wm", "key": "  󰨇 ", "keyColor": "blue" },
    { "type": "terminal", "key": "   ", "keyColor": "magenta" },
    { "type": "shell", "key": "   ", "keyColor": "yellow" },
    "break",
    { "type": "custom", "format": "┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫" },
    "break",
    { "type": "host", "key": "   ", "keyColor": "bright_blue", "format": "{vendor} {version} [{name}]" },
    { "type": "display", "key": "  󰍹 ", "compactType": "none", "preciseRefreshRate": false, // {6} = Monitor Name, {1}x{2} = Res, {3} = Refresh Rate, {7} = Physical Type (Builtin/External)
    "format": "{6} ({7}) - {1}x{2} @ {3}Hz" },
    { "type": "cpu", "key": "   ", "showPeCoreCount": true, "keyColor": "bright_green" },
    { "type": "gpu", "key": "  󰾲 ", "keyColor": "red" },
    // { "type": "vulkan", "key": "  󱎓 ", "keyColor": "red", "format": "Vulkan {version} supported by {api-version} ({name})" },
    { "type": "memory", "key": "  󰍛 ", "keyColor": "bright_yellow" },
    { "type": "swap", "key": "  󰓡 ", "keyColor": "bright_yellow" },
    { "type": "disk", "key": "   ", "keyColor": "bright_cyan" },
    { "type": "uptime", "key": "   " },
    "break",
    { "type": "custom", "format": "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛" }
  ]
}
