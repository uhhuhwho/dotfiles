# ═══════════════════════════════════════════════════════════════════════
#  Liquid Glass Theme for Hyprlock
#  Matching Waybar & wlogout frosted glass design
#  Catppuccin Mocha accent palette
# ═══════════════════════════════════════════════════════════════════════

$font = Lexend

# ─────────────────────────────────────────────────────────────────────────
#  General
# ─────────────────────────────────────────────────────────────────────────
general {
    hide_cursor = true
    grace = 0
}

# ─────────────────────────────────────────────────────────────────────────
#  Animations – smooth fade matching waybar cubic-bezier transitions
# ─────────────────────────────────────────────────────────────────────────
animations {
    enabled = true
    bezier = glassEase, 0.4, 0, 0.2, 1
    animation = fadeIn, 1, 5, glassEase
    animation = fadeOut, 1, 5, glassEase
    animation = inputFieldDots, 1, 3, glassEase
}

# ─────────────────────────────────────────────────────────────────────────
#  Background – Frosted screenshot (matches wlogout's rgba(15,15,25,0.85))
# ─────────────────────────────────────────────────────────────────────────
background {
    monitor =
    path = screenshot
    blur_passes = 4
    blur_size = 6
    noise = 0.02
    contrast = 0.9
    brightness = 0.7
    vibrancy = 0.15
    vibrancy_darkness = 0.3
    color = rgba(15, 15, 25, 1.0)
}

# ═══════════════════════════════════════════════════════════════════════
#  TIME – Large centered clock
#  Positioned center-top of screen
# ═══════════════════════════════════════════════════════════════════════
label {
    monitor =
    text = $TIME12
    color = rgba(205, 214, 244, 1.0)
    font_size = 96
    font_family = $font

    shadow_passes = 2
    shadow_size = 8
    shadow_color = rgba(0, 0, 0, 0.5)
    shadow_boost = 0.8

    position = 0, 220
    halign = center
    valign = center
}

# ═══════════════════════════════════════════════════════════════════════
#  DATE – Below the clock
# ═══════════════════════════════════════════════════════════════════════
label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B %Y"
    color = rgba(205, 214, 244, 0.7)
    font_size = 22
    font_family = $font

    shadow_passes = 1
    shadow_size = 4
    shadow_color = rgba(0, 0, 0, 0.4)

    position = 0, 130
    halign = center
    valign = center
}

# ═══════════════════════════════════════════════════════════════════════
#  GREETING – "Welcome back" text
# ═══════════════════════════════════════════════════════════════════════
label {
    monitor =
    text = Hi, $USER
    color = rgba(137, 180, 250, 0.9)
    font_size = 18
    font_family = $font

    shadow_passes = 1
    shadow_size = 4
    shadow_color = rgba(0, 0, 0, 0.3)

    position = 0, 60
    halign = center
    valign = center
}

# ═══════════════════════════════════════════════════════════════════════
#  INPUT FIELD – Glassmorphic password field
#  Styled to match waybar module pills with Catppuccin accents
# ═══════════════════════════════════════════════════════════════════════
input-field {
    monitor =
    size = 320, 55
    outline_thickness = 2
    rounding = 16

    # Glass fill – matches waybar's rgba(255,255,255, 0.08)
    inner_color = rgba(255, 255, 255, 0.08)

    # Border colors – Catppuccin accent gradients
    # Normal: blue like active workspace
    outer_color = rgba(137, 180, 250, 0.55) rgba(116, 199, 236, 0.45) 45deg
    # Checking: green like battery charging
    check_color = rgba(166, 227, 161, 0.7) rgba(148, 226, 213, 0.6) 120deg
    # Failed: pink like power/temperature module
    fail_color = rgba(243, 139, 168, 0.7) rgba(255, 100, 100, 0.6) 40deg
    # Caps Lock: amber/yellow warning
    capslock_color = rgba(249, 226, 175, 0.7) rgba(242, 205, 205, 0.6) 45deg

    font_color = rgba(205, 214, 244, 0.9)
    fade_on_empty = false

    font_family = $font
    placeholder_text = <span foreground="##a6adc8">  Enter password...</span>
    fail_text = <span foreground="##f38ba8">  $PAMFAIL</span>

    dots_size = 0.25
    dots_spacing = 0.25
    dots_center = true
    dots_rounding = -1
    dots_fade_time = 200

    shadow_passes = 2
    shadow_size = 8
    shadow_color = rgba(0, 0, 0, 0.35)
    shadow_boost = 0.6

    position = 0, -20
    halign = center
    valign = center
}

# ═══════════════════════════════════════════════════════════════════════
#  CAPS LOCK INDICATOR
#  Shows only when Caps Lock is active, pink warning color
# ═══════════════════════════════════════════════════════════════════════
label {
    monitor =
    text = cmd[update:500] awk '{if ($0 == 1) print "󰘲 CAPS LOCK"}' /sys/class/leds/input*::capslock/brightness
    color = rgba(249, 226, 175, 1.0)
    font_size = 13
    font_family = $font

    shadow_passes = 1
    shadow_size = 4
    shadow_color = rgba(0, 0, 0, 0.4)

    position = 0, -75
    halign = center
    valign = center
}

# ═══════════════════════════════════════════════════════════════════════
#  KEYBOARD LAYOUT – Language indicator
#  Styled like waybar's language module with teal accent
# ═══════════════════════════════════════════════════════════════════════
label {
    monitor =
    text = $LAYOUT[en,ar]
    color = rgba(116, 199, 236, 0.8)
    font_size = 14
    font_family = $font
    onclick = hyprctl switchxkblayout all next

    shadow_passes = 1
    shadow_size = 3
    shadow_color = rgba(0, 0, 0, 0.3)

    position = 0, -115
    halign = center
    valign = center
}

# ═══════════════════════════════════════════════════════════════════════
#  LOCK ICON – Subtle indicator at the bottom
# ═══════════════════════════════════════════════════════════════════════
label {
    monitor =
    text = 
    color = rgba(255, 255, 255, 0.15)
    font_size = 28
    font_family = $font

    position = 0, 48
    halign = center
    valign = bottom
}
