# Ignore machine-local secrets and overrides
*.local
*.local.*
*.secrets
*.env

# Ignore runtime and cache files
*.log
*.tmp
*.bak
*.swp
*~
__pycache__/
*.pyc

# Ignore OS-specific garbage
.DS_Store
Thumbs.db

# Ignore container runtime data & volumes
docker/**/data/
docker/**/storage/
docker/**/mysql/
docker/**/config/
docker/**/plugins/
docker/**/extensions/
